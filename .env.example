# ProxiSpeak Backend Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit real secrets. The .env file is ignored by Git.

# --- Database and geospatial layer (this branch, dev-kuldeep) ---
# Read by db.js (Mongoose connection) and seed.js (opt-in guard).

MONGODB_URI=mongodb://127.0.0.1:27017/procsispeak

# Explicit opt-in for seeding. Set to "development" to allow seeding.
# Seeding is refused unless this is set or --confirm-seed is passed.
SEED_DB=development

# --- Signaling server (server branch) ---
# Read by the Express and Socket.io server.

PORT=5000

NODE_ENV=development

CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Proximity configuration shared by both sides ---
# Read by the in-memory proximity engine on the server branch and by the
# 100-pixel canvas radius used on this branch.

EARSHOT_RADIUS_PIXELS=100

MAX_PEERS_PER_ZONE=20
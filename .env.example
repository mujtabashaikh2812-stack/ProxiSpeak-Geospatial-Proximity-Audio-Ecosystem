# ProxiSpeak Backend Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit real secrets. The .env file is ignored by Git.

# MongoDB connection URI.
# Local development fallback (used if MONGODB_URI is not set):
#   mongodb://127.0.0.1:27017/procsispeak
# For development/test, point to a disposable database. Never seed production.
MONGODB_URI=mongodb://127.0.0.1:27017/procsispeak

# Explicit opt-in for seeding. Set to "development" to allow seeding.
# Seeding is refused unless this is set or --confirm-seed is passed.
SEED_DB=development

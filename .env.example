# ProxiSpeak Backend Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit real secrets. The .env file is ignored by Git.

# --- Server & Signaling Configuration ---
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Allowed Frontend Origins (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5000

# --- Database & Cache Layer ---
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak
REDIS_URL=redis://127.0.0.1:6379

# Explicit opt-in for seeding (dev-kuldeep)
SEED_DB=development

# --- Geospatial & Proximity Configuration ---
EARSHOT_RADIUS_PIXELS=100
MAX_PEERS_PER_ZONE=20
